# Backend environment configuration. Never commit real secrets.
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/school_management
FRONTEND_URLS=http://localhost:3000

# Generate a fresh value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
AUTH_SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SAME_SITE=lax
